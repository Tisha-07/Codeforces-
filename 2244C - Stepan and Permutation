import java.io.*;
import java.util.*;

public class Sol {
    static int[] parent, rank_;

    static int find(int a) {
        while (parent[a] != a) {
            parent[a] = parent[parent[a]];
            a = parent[a];
        }
        return a;
    }

    static void union(int a, int b) {
        int ra = find(a), rb = find(b);
        if (ra == rb) return;
        if (rank_[ra] < rank_[rb]) { int tmp = ra; ra = rb; rb = tmp; }
        parent[rb] = ra;
        if (rank_[ra] == rank_[rb]) rank_[ra]++;
    }

    public static void main(String[] args) throws IOException {
        DataInputStream in = new DataInputStream(new BufferedInputStream(System.in, 1 << 16));
        int t = nextInt(in);
        StringBuilder sb = new StringBuilder();
        while (t-- > 0) {
            int n = nextInt(in);
            int x = nextInt(in);
            int y = nextInt(in);
            int[] p = new int[n];
            for (int i = 0; i < n; i++) p[i] = nextInt(in);

            parent = new int[n];
            rank_ = new int[n];
            for (int i = 0; i < n; i++) parent[i] = i;

            for (int i = 0; i + x < n; i++) union(i, i + x);
            for (int i = 0; i + y < n; i++) union(i, i + y);

            boolean ok = true;
            for (int i = 0; i < n; i++) {
                int target = p[i] - 1;
                if (find(i) != find(target)) {
                    ok = false;
                    break;
                }
            }
            sb.append(ok ? "YES\n" : "NO\n");
        }
        System.out.print(sb);
    }

    private static int nextInt(DataInputStream in) throws IOException {
        int ret = 0;
        int b = in.read();
        while (b < '0' || b > '9') {
            if (b == '-') break;
            b = in.read();
        }
        boolean neg = false;
        if (b == '-') { neg = true; b = in.read(); }
        while (b >= '0' && b <= '9') {
            ret = ret * 10 + (b - '0');
            b = in.read();
        }
        return neg ? -ret : ret;
    }
}

import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int freeOfficers = 0;
        int untreated = 0;

        for (int i = 0; i < n; i++) {
            int event = sc.nextInt();

            if (event == -1) {
                if (freeOfficers > 0) {
                    freeOfficers--; // One free officer handles the crime
                } else {
                    untreated++;    // No officer available
                }
            } else {
                freeOfficers += event; // New recruits become available
            }
        }

        System.out.println(untreated);
    }
}

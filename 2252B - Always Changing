import java.io.*;
import java.util.*;

public class Main {

    static int solve(String s) {
        int n = s.length();

        int ans = Integer.MAX_VALUE;

        // Try keeping an alternating subsequence
        // starting with '0' and starting with '1'.
        for (char start : new char[]{'0', '1'}) {
            char expected = start;
            int kept = 0;
            int kept0 = 0;
            int kept1 = 0;

            for (int i = 0; i < n; i++) {
                if (s.charAt(i) == expected) {
                    kept++;

                    if (expected == '0') {
                        kept0++;
                    } else {
                        kept1++;
                    }

                    expected = (expected == '0') ? '1' : '0';
                }
            }

            int deleted = n - kept;
            int deleted0 = count(s, '0') - kept0;
            int deleted1 = count(s, '1') - kept1;

            // Deleted characters must be strictly alternating,
            // therefore their counts can differ by at most 1.
            if (Math.abs(deleted0 - deleted1) <= 1) {
                ans = Math.min(ans, deleted);
            }
        }

        return ans == Integer.MAX_VALUE ? -1 : ans;
    }

    static int count(String s, char c) {
        int cnt = 0;
        for (char x : s.toCharArray()) {
            if (x == c) cnt++;
        }
        return cnt;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();
            String s = sc.next();

            System.out.println(solve(s));
        }

        sc.close();
    }
}
